---
import { brickTile } from "../lib/bricks"
const tile = brickTile()
---
<svg class="bricks" aria-hidden="true">
    <defs>
        <pattern id="bricks" patternUnits="userSpaceOnUse" width={tile.width} height={tile.height} fill="currentColor" set:html={tile.svg} />
    </defs>
    <rect width="100%" height="100%" fill="url(#bricks)" />
</svg>
