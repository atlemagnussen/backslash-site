---
import { CATEGORY_ICONS } from "../lib/icons"
interface Props { category: string | null; class?: string }
const { category, class: className } = Astro.props
const paths = category ? CATEGORY_ICONS[category] : undefined
---
{paths && (
    <svg class:list={["category-icon", className]} viewBox="0 0 24 24" aria-hidden="true"
        fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        set:html={paths} />
)}
