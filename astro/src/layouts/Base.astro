---
import "@fontsource-variable/geist-mono"
import "../styles/global.css"
import Bricks from "../components/Bricks.astro"
import Sidebar from "../components/Sidebar.astro"

interface Props { title?: string; description?: string; active?: string; path?: string }
const { title, description = "Personal blog and technical notes.", active, path = Astro.url.pathname } = Astro.props
const fullTitle = title ? `${title} · backslash` : "backslash"
const clean = path.replace(/\.html$/, "").replace(/\/index$/, "")
const prompt = `~${clean === "/" ? "" : clean}`
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={new URL(path, Astro.site)}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate" type="application/rss+xml" title="backslash" href="/rss.xml">
    <link rel="sitemap" href="/sitemap-index.xml">
    <meta name="theme-color" content="#161616">
    <script is:inline>
        try { const p = localStorage.getItem("palette"); if (p) document.documentElement.dataset.palette = p } catch {}
    </script>
</head>
<body>
    <Bricks />
    <div class="app">
        <Sidebar active={active} />
        <main>
            <div class="content">
                <div class="prompt"><span class="user">guest@backslash</span>:<span class="path">{prompt}</span>$<span class="cursor" /></div>
                <slot />
            </div>
        </main>
    </div>
    <script>import "../scripts/copy-code"</script>
</body>
</html>
