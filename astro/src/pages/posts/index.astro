---
import Base from "../../layouts/Base.astro"
import { getPosts, tree, fmtDate, url } from "../../lib/posts"
const groups = tree(await getPosts())
---
<Base title="posts" path="/posts">
    <h1>posts</h1>
    {groups.map(({ category, items }) => <>
        <div class="cmd"><span class="dollar">$</span> ls {category}/</div>
        <ul class="ls">
            {items.map(p => <li><span class="date">{fmtDate(p.data.date)}</span><a href={url(p)} title={p.title}>{p.title}</a></li>)}
        </ul>
    </>)}
</Base>
